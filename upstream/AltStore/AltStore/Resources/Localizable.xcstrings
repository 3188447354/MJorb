      }
    },
    "While AltStore 2.0 is in beta, you may choose to ignore this warning at your own risk until the source is updated." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltStore 2.0はベータ版ですが、ソースがアップデートされるまでは自己責任でこの警告を無視することもできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enquanto o AltStore 2.0 estiver em versão beta, você pode ignorar este aviso por sua conta e risco até que a fonte seja atualizada."
          }
        }
      }
    },
    "wired AltServer" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有線AltServer"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltServer via cabo"
          }
        }
      }
    },
    "Would you like to add the source “%@”?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソース「%@」を追加しますか？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostaria de adicionar a fonte “%@”?"
          }
        }
      }
    },
    "Would you like to bridge your Bluesky account to the fediverse?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blueskyアカウントをフェディバースにブリッジしますか？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostaria de vincular sua conta do Bluesky ao fediverse?"
          }
        }
      }
    },
    "Would you like to download the last version compatible with this device instead?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "代わりに、このデバイスと互換性のある最新バージョンをダウンロードしますか？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostaria de baixar a última versão compatível com este dispositivo?"
          }
        }
      }
    },
    "Would you like to remove this app's extensions so they don't count towards your limit?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリの拡張機能を削除して、制限にカウントされないようにしますか？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gostaria de remover as extensões deste app para que não sejam contabilizadas no seu limite?"
          }
        }
      }
    },
    "You are not signed in." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインインしていません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não está conectado."
          }
        }
      }
    },
    "You can register another App ID in %@." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@後に別のアプリIDを登録できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você poderá registrar outro App ID em %@."
          }
        }
      }
    },
    "You cannot register more than 10 App IDs within a 7 day period." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7日間で登録できるアプリIDは10件までです。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não pode registrar mais de 10 App IDs em um período de 7 dias."
          }
        }
      }
    },
    "You must add this source before installing apps from it.\n\n“%@” will begin downloading once it has been added." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このソースからアプリをインストールする前に、このソースを追加する必要があります。\n\n「%@」は追加されるとすぐにダウンロードを開始します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você precisa adicionar esta fonte antes de instalar apps a partir dela.\n\n“%@” começará a ser baixado assim que for adicionada."
          }
        }
      }
    },
    "You must also delete it from the home screen to fully uninstall the app." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを完全にアンインストールするには、ホーム画面からも削除する必要があります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você também deve excluí-lo da tela inicial para desinstalar completamente o app."
          }
        }
      }
    },
    "You will no longer be able to install or refresh any apps that require pledges." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支援を必要とするアプリのインストールや更新ができなくなります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não poderá mais instalar ou atualizar apps que exijam contribuição."
          }
        }
      }
    },
    "You will no longer be able to install or refresh apps once you sign out." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サインアウトすると、アプリのインストールや更新ができなくなります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você não poderá mais instalar ou atualizar aplicativos após sair da conta."
          }
        }
      }
    },
    "You will no longer be able to install or update any apps that require pledges." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支援を必要とするアプリのインストールやアップデートができなくなります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
