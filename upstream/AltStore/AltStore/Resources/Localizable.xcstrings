    "%@ can not jailbreak this device unless you untether it first. Are you sure you want to install without untethering?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まずアンテザードしない限り、%@はこのデバイスを脱獄することができません。アンテザードなしでインストールしてもよろしいですか？"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não pode fazer o jailbreak deste dispositivo a menos que você faça o untether primeiro. Tem certeza de que deseja instalar sem fazer o untether?"
          }
        }
      }
    },
