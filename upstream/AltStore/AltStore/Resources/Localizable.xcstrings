          }
        }
      }
    },
    "one or more apps" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1つ以上のアプリ"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "um ou mais apps"
          }
        }
      }
    },
    "One or more apps in source “%@” are missing a marketplaceID. This most likely means they are not notarized, which is not supported by this version of AltStore." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソース「%@」内の1つ以上のアプリにマーケットプレイスIDが欠落しています。これはおそらく、アプリが公証されていないことを意味しており、このバージョンのAltStoreではサポートされていません。"
