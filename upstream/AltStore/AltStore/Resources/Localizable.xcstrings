    "Entitlements are additional permissions that grant access to certain system services, including potentially sensitive information." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エンタイトルメントは、特定のシステムサービスへのアクセスを許可する追加の権限です。これらのサービスは機密性の高い情報へのアクセスを提供することがあります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entitlements são permissões extras que dão acesso a serviços do sistema, incluindo informações potencialmente sensíveis."
          }
        }
      }
