    "Make sure Mail is running and the plug-in is enabled in Mail's preferences." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メールアプリが実行されていること、およびメールアプリの環境設定でプラグインが有効になっていることを確認してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certifique-se de que o Mail esteja em execução e que o plug-in esteja habilitado nas preferências do Mail."
          }
        }
      }
    },
    "Make sure the app is running in the foreground on %@ then try again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@上でアプリがフォアグラウンドで実行されていることを確認してから、もう一度お試しください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certifique-se de que o app esteja em execução em primeiro plano em %@ e tente novamente."
          }
        }
      }
    },
    "Make sure you have trusted this device with your computer and Wi-Fi sync is enabled." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスがコンピュータで信頼済みであることを確認し、Wi-Fi同期が有効になっていることを確認してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certifique-se de que este dispositivo esteja marcado como confiável no computador e que a sincronização por Wi-Fi esteja ativada."
          }
        }
      }
    },
