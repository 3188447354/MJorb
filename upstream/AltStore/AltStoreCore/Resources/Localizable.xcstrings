        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ recebeu uma solicitação inválida do AltServer."
          }
        }
      }
    },
    "%@ requires %@ or later." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ requires %2$@ or later."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は%2$@以降を必要とします。"
          }
